# ==== Worker Secrets（用 wrangler secret put 注入，不要提交到 git）====

# 管理后台 / 手动触发测速接口的鉴权 Token，至少 32 位随机字符串
ADMIN_TOKEN=replace_with_a_long_random_secret

# RIPE Atlas 平台 API Key（用于发起跨国真实测量）
RIPE_ATLAS_API_KEY=replace_with_your_ripe_atlas_key

# 允许访问后台 API 的前端源，CORS 白名单，逗号分隔
ALLOWED_ORIGINS=https://www.brodydung.eu.org,https://status.brodydung.eu.org
